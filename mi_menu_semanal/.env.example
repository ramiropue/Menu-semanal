NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Control de activación del guard de autenticación privada en servidor (middleware / proxy / Server Components).
# Permanece desactivado (false) para mantener acceso público V1 hasta verificar miembros autorizados de la unidad familiar.
AUTH_GUARD_ENABLED=false

# Control de visibilidad en cliente de controles de autenticación privada (e.g. botón Cerrar sesión).
# Permanece desactivado (false) para no alterar la interfaz pública V1.
NEXT_PUBLIC_AUTH_GUARD_ENABLED=false

# Control de persistencia en tabla shared_state (Modo V2).
# Permanece desactivado (false) para mantener modo V1 (filas especiales en categories) intacto.
NEXT_PUBLIC_SHARED_STATE_ENABLED=false
